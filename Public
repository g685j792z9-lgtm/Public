<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="day">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>سَكِينَة — الاستغفار والتسبيح</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Cairo, Tajawal, and Amiri for sacred Arabic typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cairo:wght@400;500;600;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet" />

  <script>
    // Configure Tailwind with custom fonts and semantic color tokens
    tailwind.config = {
      darkMode: ['selector', '[data-theme="night"]'],
      theme: {
        extend: {
          fontFamily: {
            sans: ['Cairo', 'Tajawal', 'sans-serif'],
            serif: ['Amiri', 'serif'],
          },
          colors: {
            emeraldCalm: {
              50: '#f1f7f4',
              100: '#deede5',
              500: '#2d6a4f',
              600: '#235640',
              700: '#1b4332',
              800: '#133125',
              900: '#0b1f17',
            },
            creamWarm: {
              50: '#fbf9f5',
              100: '#f4efe6',
              200: '#eae1d3',
            },
            goldMuted: {
              300: '#e2c98a',
              400: '#cfa95c',
              500: '#b58d3d',
              600: '#93702b',
            }
          }
        }
      }
    };
  </script>

  <style>
    /* Theme CSS Variables for seamless day/night transition */
    :root,
    [data-theme="day"] {
      --bg-page: #fbf9f5;
      --bg-card: #ffffff;
      --bg-subtle: #f3ede2;
      --bg-accent-soft: #eaf4ee;
      --text-primary: #172a22;
      --text-secondary: #4e6359;
      --text-muted: #76887f;
      --border-subtle: rgba(45, 106, 79, 0.14);
      --border-gold: rgba(181, 141, 61, 0.35);
      --primary: #2d6a4f;
      --primary-hover: #21523c;
      --gold: #b58d3d;
      --ring-track: #e3ece7;
      --ring-fill: #2d6a4f;
      --pattern-opacity: 0.045;
      --shadow-soft: 0 10px 30px -12px rgba(23, 42, 34, 0.08);
      --shadow-bead: 0 12px 24px -8px rgba(45, 106, 79, 0.28), inset 0 2px 4px rgba(255, 255, 255, 0.45);
    }

    [data-theme="night"] {
      --bg-page: #0c1713;
      --bg-card: #12221c;
      --bg-subtle: #182c24;
      --bg-accent-soft: #1a3329;
      --text-primary: #edf4f0;
      --text-secondary: #a8bdb3;
      --text-muted: #758e82;
      --border-subtle: rgba(126, 189, 158, 0.14);
      --border-gold: rgba(207, 169, 92, 0.32);
      --primary: #489472;
      --primary-hover: #58aa86;
      --gold: #cfa95c;
      --ring-track: #1f372e;
      --ring-fill: #cfa95c;
      --pattern-opacity: 0.04;
      --shadow-soft: 0 12px 32px -12px rgba(0, 0, 0, 0.55);
      --shadow-bead: 0 14px 28px -8px rgba(0, 0, 0, 0.65), inset 0 2px 4px rgba(255, 255, 255, 0.12);
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-primary);
      font-family: 'Cairo', 'Tajawal', sans-serif;
      transition: background-color 0.4s ease, color 0.35s ease;
      overflow-x: hidden;
    }

    /* Subtle geometric Islamic lattice background pattern */
    .islamic-pattern {
      background-image: url("data:image/svg+xml,%3Csvg width='88' height='88' viewBox='0 0 88 88' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%232d6a4f' stroke-width='0.9'%3E%3Cpath d='M44 4 L55 21 L76 12 L67 33 L84 44 L67 55 L76 76 L55 67 L44 84 L33 67 L12 76 L21 55 L4 44 L21 33 L12 12 L33 21 Z'/%3E%3Ccircle cx='44' cy='44' r='14'/%3E%3Ccircle cx='44' cy='44' r='28' stroke-dasharray='3 4'/%3E%3C/g%3E%3C/svg%3E");
      background-size: 88px 88px;
      opacity: var(--pattern-opacity);
      pointer-events: none;
    }

    [data-theme="night"] .islamic-pattern {
      background-image: url("data:image/svg+xml,%3Csvg width='88' height='88' viewBox='0 0 88 88' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23cfa95c' stroke-width='0.9'%3E%3Cpath d='M44 4 L55 21 L76 12 L67 33 L84 44 L67 55 L76 76 L55 67 L44 84 L33 67 L12 76 L21 55 L4 44 L21 33 L12 12 L33 21 Z'/%3E%3Ccircle cx='44' cy='44' r='14'/%3E%3Ccircle cx='44' cy='44' r='28' stroke-dasharray='3 4'/%3E%3C/g%3E%3C/svg%3E");
    }

    .surface-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-soft);
      transition: background-color 0.35s ease, border-color 0.35s ease, transform 0.25s ease;
    }

    .subtle-box {
      background-color: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      transition: background-color 0.35s ease, border-color 0.35s ease;
    }

    .gold-border {
      border-color: var(--border-gold);
    }

    /* Tasbih interactive button elevation & ripple pulse */
    .tasbih-btn {
      box-shadow: var(--shadow-bead);
      transition: transform 0.14s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s ease, background-color 0.3s ease;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    .tasbih-btn:active {
      transform: scale(0.955);
    }

    @keyframes gentlePulseRing {
      0% {
        transform: scale(0.94);
        opacity: 0.55;
      }
      100% {
        transform: scale(1.24);
        opacity: 0;
      }
    }

    .pulse-ring-anim {
      animation: gentlePulseRing 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes toastFadeIn {
      0% {
        opacity: 0;
        transform: translateY(10px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .toast-anim {
      animation: toastFadeIn 0.28s ease-out forwards;
    }

    /* Welcome Splash Overlay Transitions */
    .welcome-overlay {
      background-color: var(--bg-page);
      transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.65s ease, transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .welcome-overlay.is-hidden {
      opacity: 0;
      visibility: hidden;
      transform: scale(1.03);
      pointer-events: none;
    }

    @keyframes welcomeCardRise {
      0% {
        opacity: 0;
        transform: translateY(18px) scale(0.98);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .welcome-card-anim {
      animation: welcomeCardRise 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Custom subtle scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(118, 136, 127, 0.35);
      border-radius: 9999px;
    }
  </style>
</head>
<body class="min-h-screen relative antialiased selection:bg-emeraldCalm-500/20 overflow-hidden">
  <!-- Elegant Welcome / Splash Screen -->
  <div
    id="welcomeSplashScreen"
    role="dialog"
    aria-modal="true"
    aria-labelledby="welcomeCreatorTitle"
    class="welcome-overlay fixed inset-0 z-50 flex items-center justify-center px-4 py-8"
  >
    <!-- Subtle Geometric Pattern Layer inside Splash -->
    <div class="fixed inset-0 islamic-pattern" aria-hidden="true"></div>

    <!-- Centered Welcome Card -->
    <div class="welcome-card-anim relative z-10 surface-card gold-border rounded-[2rem] p-7 sm:p-11 max-w-md w-full text-center space-y-6">
      <!-- Top Decorative Islamic Crescent & Star Emblem -->
      <div class="mx-auto w-20 h-20 rounded-3xl flex items-center justify-center border gold-border relative" style="background-color: var(--bg-accent-soft); color: var(--primary);">
        <div class="absolute inset-1.5 rounded-2xl border opacity-40" style="border-color: var(--gold);"></div>
        <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          <path d="M19 3v4"></path>
          <path d="M21 5h-4"></path>
        </svg>
      </div>

      <!-- App Title & Subtitle -->
      <div class="space-y-1.5">
        <p class="font-serif text-2xl sm:text-3xl font-bold tracking-wide" style="color: var(--primary);">
          سَكِينَة
        </p>
        <p class="text-xs sm:text-sm" style="color: var(--text-muted);">
          واحة الاستغفار والتسبيح وطمأنينة القلب
        </p>
      </div>

      <!-- Ornamental Divider -->
      <div class="flex items-center justify-center gap-3" aria-hidden="true">
        <span class="h-px flex-1 max-w-[70px]" style="background-color: var(--border-gold);"></span>
        <span class="w-2 h-2 rotate-45 inline-block" style="background-color: var(--gold);"></span>
        <span class="h-px flex-1 max-w-[70px]" style="background-color: var(--border-gold);"></span>
      </div>

      <!-- Developer / Creator Signature -->
      <div class="subtle-box rounded-2xl py-4 px-5 border gold-border space-y-1">
        <span class="block text-[11px] font-semibold tracking-wider" style="color: var(--text-muted);">
          إعداد وتطوير
        </span>
        <h2
          id="welcomeCreatorTitle"
          dir="ltr"
          class="text-2xl sm:text-3xl font-bold tracking-wide"
          style="color: var(--gold); font-family: 'Cairo', sans-serif;"
        >
          Eng: SAMER MOHAMED 
        </h2>
      </div>

      <!-- Continue Button -->
      <div class="pt-1">
        <button
          id="welcomeContinueBtn"
          type="button"
          class="tasbih-btn w-full py-3.5 px-6 rounded-2xl text-base sm:text-lg font-bold text-white inline-flex items-center justify-center gap-2.5 cursor-pointer focus:outline-none focus-visible:ring-4"
          style="background: linear-gradient(135deg, var(--primary), var(--primary-hover)); --tw-ring-color: color-mix(in srgb, var(--primary) 35%, transparent);"
        >
          <span>استمرار</span>
          <svg class="w-5 h-5 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Decorative Islamic geometric background -->
  <div class="fixed inset-0 islamic-pattern z-0" aria-hidden="true"></div>

  <!-- Top Navigation & Theme Bar -->
  <header class="sticky top-0 z-30 backdrop-blur-md border-b" style="background-color: color-mix(in srgb, var(--bg-page) 84%, transparent); border-color: var(--border-subtle);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between gap-3">
      <!-- Brand Identity -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl flex items-center justify-center gold-border border" style="background-color: var(--bg-accent-soft); color: var(--primary);">
          <!-- Crescent & Star / Rosette SVG -->
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            <path d="M19 3v4"></path>
            <path d="M21 5h-4"></path>
          </svg>
        </div>
        <div>
          <h1 class="font-serif text-xl sm:text-2xl font-bold tracking-wide leading-tight" style="color: var(--primary);">
            سَكِينَة
          </h1>
          <p class="text-xs sm:text-[13px]" style="color: var(--text-muted);">
            واحة الاستغفار والتسبيح وطمأنينة القلب
          </p>
        </div>
      </div>

      <!-- Quick Navigation & Theme Toggle -->
      <div class="flex items-center gap-2 sm:gap-3">
        <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
          <a href="#tasbih-section" class="px-3.5 py-2 rounded-xl transition hover:opacity-80" style="color: var(--text-secondary);">السبحة</a>
          <a href="#stats-section" class="px-3.5 py-2 rounded-xl transition hover:opacity-80" style="color: var(--text-secondary);">إحصاءات اليوم</a>
          <a href="#virtues-section" class="px-3.5 py-2 rounded-xl transition hover:opacity-80" style="color: var(--text-secondary);">الفضائل والآيات</a>
        </nav>

        <!-- Sound Toggle Button -->
        <button
          id="soundToggleBtn"
          type="button"
          aria-label="تفعيل أو كتم صوت النقرة"
          title="صوت نقرة هادئ"
          class="p-2.5 sm:px-3.5 sm:py-2 rounded-xl border flex items-center gap-1.5 text-xs sm:text-sm font-medium transition cursor-pointer"
          style="background-color: var(--bg-card); border-color: var(--border-subtle); color: var(--text-secondary);"
        >
          <span id="soundIconWrap" class="flex items-center"></span>
          <span id="soundLabel" class="hidden sm:inline">الصوت</span>
        </button>

        <!-- Day / Night Theme Toggle -->
        <button
          id="themeToggleBtn"
          type="button"
          aria-label="تبديل الوضع النهاري والليلي"
          class="p-2.5 sm:px-3.5 sm:py-2 rounded-xl border flex items-center gap-2 text-xs sm:text-sm font-semibold transition cursor-pointer gold-border"
          style="background-color: var(--bg-accent-soft); color: var(--text-primary);"
        >
          <span id="themeIconWrap" class="flex items-center" style="color: var(--gold);"></span>
          <span id="themeLabel" class="hidden sm:inline">ليلي</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-10 sm:space-y-14">

    <!-- Inspiring Opening Banner -->
    <section class="surface-card rounded-3xl p-5 sm:p-8 relative overflow-hidden gold-border">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-5">
        <div class="space-y-2 max-w-2xl">
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full" style="background-color: var(--bg-accent-soft); color: var(--primary);">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L14.8 8.6L22 9.3L16.5 14L18.2 21L12 17.3L5.8 21L7.5 14L2 9.3L9.2 8.6L12 2Z"></path>
            </svg>
            ذكرٌ يحيي القلوب ويشرح الصدور
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold leading-relaxed" style="color: var(--text-primary);">
            ﴿ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ ﴾
          </h2>
          <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-secondary);">
            خصص لحظاتٍ هادئة للاستغفار والتسبيح في يومك، وتابع وردك اليومي بكل سكينة وطمأنينة.
          </p>
        </div>

        <!-- Daily Quick Summary Pill -->
        <div class="subtle-box rounded-2xl p-4 sm:px-6 flex items-center gap-4 shrink-0 self-start md:self-center">
          <div class="w-12 h-12 rounded-2xl flex items-center justify-center" style="background-color: var(--bg-accent-soft); color: var(--gold);">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 3"></path>
            </svg>
          </div>
          <div>
            <div class="text-xs font-medium" style="color: var(--text-muted);">مجموع تسبيحات اليوم</div>
            <div id="bannerTodayTotal" class="text-2xl font-bold tabular-nums" style="color: var(--primary);">0</div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 1: Interactive Digital Tasbih Counter -->
    <section id="tasbih-section" class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">

      <!-- Left/Main Column: Dhikr Selector + Circular Counter + Controls -->
      <div class="lg:col-span-7 surface-card rounded-3xl p-5 sm:p-8 space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b pb-4" style="border-color: var(--border-subtle);">
          <div>
            <h3 class="text-lg sm:text-xl font-bold flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full inline-block" style="background-color: var(--gold);"></span>
              السبحة الإلكترونية
            </h3>
            <p class="text-xs sm:text-sm mt-0.5" style="color: var(--text-muted);">اختر الذكر أو أضف ذكراً خاصاً بك ثم اضغط للعدّ</p>
          </div>

          <!-- Target Selector Pills -->
          <div class="flex items-center gap-1.5 flex-wrap" role="group" aria-label="اختيار الهدف">
            <span class="text-xs font-medium ml-1" style="color: var(--text-muted);">الهدف:</span>
            <button type="button" data-target="33" class="target-pill px-3 py-1.5 rounded-xl text-xs font-bold border transition cursor-pointer">33</button>
            <button type="button" data-target="100" class="target-pill px-3 py-1.5 rounded-xl text-xs font-bold border transition cursor-pointer">100</button>
            <button type="button" id="customTargetBtn" class="target-pill px-3 py-1.5 rounded-xl text-xs font-bold border transition cursor-pointer">مخصص</button>
          </div>
        </div>

        <!-- Custom Target Input Drawer (Hidden by default) -->
        <div id="customTargetPanel" class="hidden subtle-box rounded-2xl p-3.5 flex flex-wrap items-center justify-between gap-3">
          <label for="customTargetInput" class="text-xs sm:text-sm font-medium" style="color: var(--text-secondary);">
            أدخل هدفاً رقمياً (مثال: 50 أو 1000):
          </label>
          <div class="flex items-center gap-2">
            <input
              id="customTargetInput"
              type="number"
              min="1"
              max="100000"
              placeholder="100"
              class="w-28 px-3 py-1.5 rounded-xl border text-sm font-bold text-center outline-none focus:ring-2"
              style="background-color: var(--bg-card); border-color: var(--border-subtle); color: var(--text-primary); --tw-ring-color: var(--primary);"
            />
            <button
              id="applyCustomTargetBtn"
              type="button"
              class="px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold text-white transition cursor-pointer"
              style="background-color: var(--primary);"
            >
              تطبيق
            </button>
          </div>
        </div>

        <!-- Dhikr Presets Grid -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold" style="color: var(--text-secondary);">الأذكار المتاحة:</span>
            <button
              id="toggleAddDhikrBtn"
              type="button"
              class="text-xs font-semibold inline-flex items-center gap-1 px-2.5 py-1 rounded-lg transition cursor-pointer"
              style="color: var(--primary); background-color: var(--bg-accent-soft);"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M12 5v14M5 12h14"></path>
              </svg>
              إضافة ذكر مخصص
            </button>
          </div>

          <!-- Add Custom Dhikr Form -->
          <form id="addDhikrForm" class="hidden subtle-box rounded-2xl p-3.5 space-y-3">
            <div class="flex flex-col sm:flex-row gap-2.5">
              <input
                id="newDhikrText"
                type="text"
                maxlength="90"
                placeholder="اكتب الذكر هنا... مثال: اللهم إنك عفو تحب العفو فاعف عني"
                class="flex-1 px-3.5 py-2 rounded-xl border text-sm outline-none focus:ring-2"
                style="background-color: var(--bg-card); border-color: var(--border-subtle); color: var(--text-primary); --tw-ring-color: var(--primary);"
              />
              <button
                type="submit"
                class="px-4 py-2 rounded-xl text-sm font-semibold text-white shrink-0 transition cursor-pointer"
                style="background-color: var(--primary);"
              >
                حفظ الذكر
              </button>
            </div>
            <p id="addDhikrError" class="hidden text-xs text-red-600 dark:text-red-400 font-medium"></p>
          </form>

          <!-- Dhikr Chips -->
          <div id="dhikrChipsContainer" class="flex flex-wrap gap-2 max-h-40 overflow-y-auto p-0.5"></div>
        </div>

        <!-- Active Dhikr Display -->
        <div class="subtle-box rounded-2xl p-4 sm:p-5 text-center space-y-1.5 gold-border border">
          <div class="flex items-center justify-center gap-2 text-xs font-medium" style="color: var(--gold);">
            <span>الذكر الحالي</span>
            <button
              id="deleteCustomDhikrBtn"
              type="button"
              class="hidden text-xs px-2 py-0.5 rounded-md text-red-600 dark:text-red-400 hover:bg-red-500/10 transition cursor-pointer"
              title="حذف هذا الذكر المخصص"
            >
              حذف الذكر
            </button>
          </div>
          <p id="activeDhikrDisplay" class="font-serif text-2xl sm:text-3xl font-bold leading-relaxed" style="color: var(--text-primary);">
            أستغفر الله العظيم
          </p>
          <p id="activeDhikrSub" class="text-xs" style="color: var(--text-muted);">
            عدّاد الدورة الحالية للذكر المختار
          </p>
        </div>

        <!-- Circular Progress Ring + Big Interactive Tasbih Tap Button -->
        <div class="flex flex-col items-center justify-center py-2 space-y-5">
          <div class="relative w-56 h-56 sm:w-64 sm:h-64 flex items-center justify-center">
            <!-- SVG Progress Ring -->

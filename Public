      function renderAll() {
        applyTheme();
        applySoundUI();
        renderDhikrChips();
        renderTargetPills();
        renderCounterSection();
        renderStatsSection();
        renderVirtuesSection();
      }

      /**
       * Increments active dhikr counter and updates daily stats + streak
       */
      function handleIncrementDhikr() {
        const today = getTodayDateString();
        if (state.todayDate !== today) {
          state.todayDate = today;
          state.todayTotal = 0;
          state.todayByDhikr = {};
        }

        const activeDhikr = getActiveDhikr();
        const prevCount = state.dhikrCounters[activeDhikr.id] || 0;
        const nextCount = prevCount + 1;

        state.dhikrCounters[activeDhikr.id] = nextCount;
        state.todayTotal = (state.todayTotal || 0) + 1;
        state.todayByDhikr[activeDhikr.id] = (state.todayByDhikr[activeDhikr.id] || 0) + 1;

        // Track active days & streak
        if (!state.recordedActiveDates.includes(today)) {
          const wasYesterday = state.lastActiveDate === getYesterdayDateString();
          state.recordedActiveDates.push(today);
          state.totalActiveDays = state.recordedActiveDates.length;
          state.streakDays = wasYesterday ? state.streakDays + 1 : 1;
        } else if (state.streakDays < 1) {
          state.streakDays = 1;
        }
        state.lastActiveDate = today;

        // Check if target milestone was just reached
        const target = Math.max(1, state.targetCount || 33);
        const reachedTarget = nextCount % target === 0;

        soundEngine.playTap(reachedTarget);

        // Subtle haptic vibration on supported mobile devices
        if (navigator.vibrate) {
          try {
            navigator.vibrate(reachedTarget ? [25, 40, 25] : 14);
          } catch (e) {}
        }

        // Visual pulse animation
        const pulseLayer = document.getElementById('tapPulseLayer');
        if (pulseLayer) {
          pulseLayer.classList.remove('pulse-ring-anim');
          void pulseLayer.offsetWidth;
          pulseLayer.classList.add('pulse-ring-anim');
        }

        if (reachedTarget) {
          const roundNum = nextCount / target;
          showToast(`ما شاء الله! أتممت ${roundNum === 1 ? 'الهدف' : `الدورة رقم ${roundNum}`} (${target}) من "${activeDhikr.text}"`);
        }

        saveState();
        renderCounterSection();
        renderStatsSection();
        renderDhikrChips();
      }

      /**
       * Resets counter for the active dhikr
       */
      function handleResetCurrentDhikr() {
        const activeDhikr = getActiveDhikr();
        state.dhikrCounters[activeDhikr.id] = 0;
        saveState();
        renderCounterSection();
        showToast(`تم تصفير عدّاد "${activeDhikr.text}"`);
      }

      /**
       * Resets today's stats counters
       */
      function handleResetTodayStats() {
        state.todayTotal = 0;
        state.todayByDhikr = {};
        saveState();
        renderStatsSection();
        renderDhikrChips();
        showToast('تم تصفير إحصاءات اليوم');
      }

      /**
       * Binds all DOM event listeners
       */
      function bindEvents() {
        // Theme toggle
        document.getElementById('themeToggleBtn').addEventListener('click', () => {
          state.theme = state.theme === 'day' ? 'night' : 'day';
          saveState();
          applyTheme();
          renderVirtuesSection();
        });

        // Sound toggle
        document.getElementById('soundToggleBtn').addEventListener('click', () => {
          state.soundEnabled = !state.soundEnabled;
          saveState();
          applySoundUI();
          if (state.soundEnabled) {
            soundEngine.playTap(false);
            showToast('تم تفعيل صوت النقرة الهادئ');
          } else {
            showToast('تم كتم الصوت');
          }
        });

        // Tasbih tap button
        document.getElementById('tasbihTapBtn').addEventListener('click', handleIncrementDhikr);

        // Keyboard Space shortcut for desktop accessibility (when not typing in an input)
        document.addEventListener('keydown', (e) => {
          const splash = document.getElementById('welcomeSplashScreen');
          if (splash && !splash.classList.contains('is-hidden')) {
            if (e.code === 'Enter' || e.code === 'Space') {
              e.preventDefault();
              document.getElementById('welcomeContinueBtn').click();
            }
            return;
          }
          const tag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
          if (tag === 'input' || tag === 'textarea') return;
          if (e.code === 'Space') {
            e.preventDefault();
            handleIncrementDhikr();
          }
        });

        // Welcome Splash Screen Continue Button
        const welcomeContinueBtn = document.getElementById('welcomeContinueBtn');
        const welcomeSplashScreen = document.getElementById('welcomeSplashScreen');
        if (welcomeContinueBtn && welcomeSplashScreen) {
          welcomeContinueBtn.addEventListener('click', () => {
            soundEngine.playTap(false);
            welcomeSplashScreen.classList.add('is-hidden');
            document.body.classList.remove('overflow-hidden');
            setTimeout(() => {
              welcomeSplashScreen.style.display = 'none';
            }, 680);
          });
        }

        // Reset current counter
        document.getElementById('resetCurrentBtn').addEventListener('click', handleResetCurrentDhikr);

        // Reset today stats
        document.getElementById('resetTodayStatsBtn').addEventListener('click', handleResetTodayStats);

        // Preset target pills (33, 100)
        document.querySelectorAll('.target-pill[data-target]').forEach(btn => {
          btn.addEventListener('click', () => {
            const val = Number(btn.getAttribute('data-target'));
            if (val > 0) {
              state.targetCount = val;
              document.getElementById('customTargetPanel').classList.add('hidden');
              saveState();
              renderTargetPills();
              renderCounterSection();
              showToast(`تم تحديد الهدف: ${val}`);
            }
          });
        });

        // Custom target toggle button
        document.getElementById('customTargetBtn').addEventListener('click', () => {
          const panel = document.getElementById('customTargetPanel');
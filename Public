      /**
       * Helper: Returns local calendar date string YYYY-MM-DD
       */
      function getTodayDateString(dateObj = new Date()) {
        const year = dateObj.getFullYear();
        const month = String(dateObj.getMonth() + 1).padStart(2, '0');
        const day = String(dateObj.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
      }

      /**
       * Helper: Returns yesterday's YYYY-MM-DD string
       */
      function getYesterdayDateString() {
        const d = new Date();
        d.setDate(d.getDate() - 1);
        return getTodayDateString(d);
      }

      /**
       * Builds initial default state
       */
      function createDefaultState() {
        const today = getTodayDateString();
        return {
          theme: 'day', // 'day' | 'night'
          soundEnabled: true,
          activeDhikrId: DEFAULT_DHIKR_PRESETS[0].id,
          targetCount: 33,
          customDhikrs: [],
          // Current counter per dhikr id
          dhikrCounters: {},
          // Daily stats
          todayDate: today,
          todayTotal: 0,
          todayByDhikr: {},
          // Streak & active days tracking
          streakDays: 1,
          totalActiveDays: 1,
          lastActiveDate: today,
          recordedActiveDates: [today],
          virtueFilter: 'all'
        };
      }

      /**
       * Loads and normalizes state from localStorage safely
       */
      function loadState() {
        const fallback = createDefaultState();
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return fallback;
          const parsed = JSON.parse(raw);
          if (!parsed || typeof parsed !== 'object') return fallback;

          const merged = {
            ...fallback,
            ...parsed,
            customDhikrs: Array.isArray(parsed.customDhikrs) ? parsed.customDhikrs : [],
            dhikrCounters: parsed.dhikrCounters && typeof parsed.dhikrCounters === 'object' ? parsed.dhikrCounters : {},
            todayByDhikr: parsed.todayByDhikr && typeof parsed.todayByDhikr === 'object' ? parsed.todayByDhikr : {},
            recordedActiveDates: Array.isArray(parsed.recordedActiveDates) && parsed.recordedActiveDates.length
              ? parsed.recordedActiveDates
              : [getTodayDateString()]
          };

          // Handle day rollover if date changed since last session
          const today = getTodayDateString();
          if (merged.todayDate !== today) {
            const wasYesterday = merged.todayDate === getYesterdayDateString();
            if (merged.todayTotal > 0) {
              merged.streakDays = wasYesterday ? Math.max(1, merged.streakDays) : 1;
            } else {
              merged.streakDays = wasYesterday ? merged.streakDays : 0;
            }
            merged.todayDate = today;
            merged.todayTotal = 0;
            merged.todayByDhikr = {};
          }

          // Ensure activeDhikrId exists in presets or customDhikrs
          const allIds = [...DEFAULT_DHIKR_PRESETS, ...merged.customDhikrs].map(d => d.id);
          if (!allIds.includes(merged.activeDhikrId)) {
            merged.activeDhikrId = DEFAULT_DHIKR_PRESETS[0].id;
          }

          return merged;
        } catch (err) {
          console.warn('Error loading state from localStorage:', err);
          return fallback;
        }
      }

      let state = loadState();

      function saveState() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch (err) {
          console.warn('Error saving state to localStorage:', err);
        }
      }

      /**
       * Web Audio API Gentle Click Synthesizer (no external files)
       */
      class GentleSoundEngine {
        constructor() {
          this.ctx = null;
        }

        ensureContext() {
          if (!this.ctx && (window.AudioContext || window.webkitAudioContext)) {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            this.ctx = new AudioCtx();
          }
          if (this.ctx && this.ctx.state === 'suspended') {
            this.ctx.resume().catch(() => {});
          }
        }

        playTap(isTargetComplete = false) {
          if (!state.soundEnabled) return;
          try {
            this.ensureContext();
            if (!this.ctx) return;

            const now = this.ctx.currentTime;

            if (isTargetComplete) {
              // Soft two-note chime when reaching target (e.g. 33 or 100)
              [523.25, 659.25].forEach((freq, idx) => {
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, now + idx * 0.11);

                gain.gain.setValueAtTime(0.0001, now + idx * 0.11);
                gain.gain.exponentialRampToValueAtTime(0.07, now + idx * 0.11 + 0.02);
                gain.gain.exponentialRampToValueAtTime(0.0001, now + idx * 0.11 + 0.36);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now + idx * 0.11);
                osc.stop(now + idx * 0.11 + 0.38);
              });
            } else {
              // Warm wooden/bead click
              const osc = this.ctx.createOscillator();
              const gain = this.ctx.createGain();
              osc.type = 'triangle';
              osc.frequency.setValueAtTime(340, now);
              osc.frequency.exponentialRampToValueAtTime(150, now + 0.045);

              gain.gain.setValueAtTime(0.0001, now);
              gain.gain.exponentialRampToValueAtTime(0.065, now + 0.008);
              gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.055);

              osc.connect(gain);
              gain.connect(this.ctx.destination);
              osc.start(now);
              osc.stop(now + 0.06);
            }
          } catch (e) {
            // Ignore audio errors on restricted devices
          }
        }
      }

      const soundEngine = new GentleSoundEngine();

      /**
       * Non-blocking toast message helper (never uses alert)
       */
      function showToast(message) {
        const container = document.getElementById('toastContainer');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = 'toast-anim px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-semibold text-white shadow-lg border border-white/15 text-center';
        toast.style.backgroundColor = 'var(--primary)';
        toast.textContent = message;

        container.appendChild(toast);
        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transition = 'opacity 0.25s ease';
          setTimeout(() => toast.remove(), 260);
        }, 2400);
      }

      /**
       * Returns all available dhikrs (default + custom)
       */
      function getAllDhikrs() {
        return [...DEFAULT_DHIKR_PRESETS, ...state.customDhikrs];
      }

      function getActiveDhikr() {
        const all = getAllDhikrs();
        return all.find(d => d.id === state.activeDhikrId) || all[0];
      }


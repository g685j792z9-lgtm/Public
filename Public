      /**
       * Renders Dhikr chips in the selector
       */
      function renderDhikrChips() {
        const container = document.getElementById('dhikrChipsContainer');
        if (!container) return;

        const allDhikrs = getAllDhikrs();
        container.innerHTML = '';

        allDhikrs.forEach(dhikr => {
          const isSelected = dhikr.id === state.activeDhikrId;
          const todayCount = state.todayByDhikr[dhikr.id] || 0;

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'px-3.5 py-2 rounded-2xl text-xs sm:text-sm font-semibold border transition flex items-center gap-2 cursor-pointer';

          if (isSelected) {
            btn.style.backgroundColor = 'var(--primary)';
            btn.style.color = '#ffffff';
            btn.style.borderColor = 'var(--primary)';
          } else {
            btn.style.backgroundColor = 'var(--bg-subtle)';
            btn.style.color = 'var(--text-primary)';
            btn.style.borderColor = 'var(--border-subtle)';
          }

          const labelSpan = document.createElement('span');
          labelSpan.textContent = dhikr.text;

          const badgeSpan = document.createElement('span');
          badgeSpan.className = 'text-[11px] px-1.5 py-0.5 rounded-full tabular-nums';
          badgeSpan.style.backgroundColor = isSelected ? 'rgba(255,255,255,0.2)' : 'var(--bg-card)';
          badgeSpan.style.color = isSelected ? '#ffffff' : 'var(--text-muted)';
          badgeSpan.textContent = todayCount;

          btn.appendChild(labelSpan);
          btn.appendChild(badgeSpan);

          btn.addEventListener('click', () => {
            state.activeDhikrId = dhikr.id;
            saveState();
            renderAll();
          });

          container.appendChild(btn);
        });
      }

      /**
       * Updates Target Pills active state
       */
      function renderTargetPills() {
        const pills = document.querySelectorAll('.target-pill');
        pills.forEach(pill => {
          const val = pill.getAttribute('data-target');
          const isCustomBtn = pill.id === 'customTargetBtn';
          const isActive = val
            ? Number(val) === state.targetCount && ![33, 100].includes(state.targetCount) === false && Number(val) === state.targetCount
            : isCustomBtn && ![33, 100].includes(state.targetCount);

          if (isActive) {
            pill.style.backgroundColor = 'var(--primary)';
            pill.style.color = '#ffffff';
            pill.style.borderColor = 'var(--primary)';
          } else {
            pill.style.backgroundColor = 'var(--bg-subtle)';
            pill.style.color = 'var(--text-secondary)';
            pill.style.borderColor = 'var(--border-subtle)';
          }
        });
      }

      /**
       * Renders Counter, Circular Progress Ring, and Linear Progress Bar
       */
      function renderCounterSection() {
        const activeDhikr = getActiveDhikr();
        const currentCount = state.dhikrCounters[activeDhikr.id] || 0;
        const target = Math.max(1, state.targetCount || 33);

        // Completed full cycles of target
        const completedRounds = Math.floor(currentCount / target);
        const countInCurrentRound = currentCount % target;
        // If user has counted >= target and is right on a multiple, show full ring if > 0
        const visualProgressCount = (currentCount > 0 && countInCurrentRound === 0) ? target : countInCurrentRound;
        const percent = Math.min(100, Math.round((visualProgressCount / target) * 100));

        document.getElementById('activeDhikrDisplay').textContent = activeDhikr.text;
        document.getElementById('currentCountDisplay').textContent = currentCount;
        document.getElementById('targetLabelDisplay').textContent = `الهدف: ${target}`;
        document.getElementById('progressPercentText').textContent = `نسبة الدورة الحالية: ${percent}%`;
        document.getElementById('completedRoundsText').textContent = `الدورات المكتملة: ${completedRounds}`;

        // Delete button visible only for custom dhikrs
        const delBtn = document.getElementById('deleteCustomDhikrBtn');
        if (activeDhikr.custom) {
          delBtn.classList.remove('hidden');
        } else {
          delBtn.classList.add('hidden');
        }

        // SVG circle circumference for r=94 => 2 * pi * 94 ≈ 590.62
        const circle = document.getElementById('progressRingCircle');
        if (circle) {
          const radius = 94;
          const circumference = 2 * Math.PI * radius;
          circle.style.strokeDasharray = `${circumference}`;
          const offset = circumference - (percent / 100) * circumference;
          circle.style.strokeDashoffset = `${offset}`;
        }

        // Linear progress bar
        const linearBar = document.getElementById('linearProgressBar');
        if (linearBar) {
          linearBar.style.width = `${percent}%`;
        }
      }

      /**
       * Renders Daily Stats, Streak, and Breakdown per Dhikr
       */
      function renderStatsSection() {
        document.getElementById('bannerTodayTotal').textContent = state.todayTotal;
        document.getElementById('statTodayTotal').textContent = state.todayTotal;
        document.getElementById('statStreakDays').textContent = state.streakDays;
